{
  "name": "walletpass-for-logistics",
  "version": "1.0.0",
  "description": "Issue Apple Wallet and Google Wallet passes for logistics parks and restricted areas",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "apple-wallet",
    "google-wallet",
    "passkit",
    "pkpass"
  ],
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "archiver": "^7.0.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.1.0",
    "jose": "^6.0.11",
    "multer": "^2.0.1",
    "node-forge": "^1.3.1",
    "passkit-generator": "^3.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.2",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.30",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
