PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# On Railway you can omit this — the app uses RAILWAY_PUBLIC_DOMAIN automatically.
# For a custom domain: PUBLIC_BASE_URL=https://your-domain.example
# Production must be an absolute URL with scheme, e.g. https://walletpass-for-logistics.pl
# Local: ./data. On Railway: mount a volume at /data (Dockerfile default DATA_DIR=/data).
DATA_DIR=./data
CERTS_DIR=./certs

# Apple Wallet
# APPLE_PASS_TYPE_ID=pass.com.your.company
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_ORG_NAME=Your Organization
# APPLE_WWDR_CERT_PATH=./certs/wwdr.pem
# APPLE_SIGNER_CERT_PATH=./certs/signerCert.pem
# APPLE_SIGNER_KEY_PATH=./certs/signerKey.pem
# APPLE_SIGNER_KEY_PASSPHRASE=

# Google Wallet
# GOOGLE_ISSUER_ID=3388xxxxxxxx
# GOOGLE_SERVICE_ACCOUNT_KEY=
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./certs/google-sa.json
# GOOGLE_CLASS_SUFFIX=walletpass
# Optional: exact Console class id (issuerId.suffix or just suffix)
# GOOGLE_CLASS_ID=3388xxxxxxxx.MyConsoleClass
# Optional image overrides (must be https://…)
# GOOGLE_HERO_IMAGE_URL=https://your-domain/wallet-assets/logistics-park-gate-hero.jpg
# GOOGLE_LOGO_IMAGE_URL=https://your-domain/wallet-assets/logo.png

# SMS — send public pass page links to recipient phones
# SMS_PROVIDER=none|twilio|smsapi|log
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# SMS_PROVIDER=smsapi
# SMSAPI_TOKEN=
# SMSAPI_FROM=WalletPass for Logistics
# SMS_MESSAGE_TEMPLATE=WalletPass for Logistics: Your pass from {{org}} — open {{url}}
# Local dry-run (logs only): SMS_PROVIDER=log

# Auth / SendGrid (same relay pattern as LogisYARD)
# SENDGRID_API_KEY=SG.xxxxxxxx
# Verified sender in SendGrid
# SENDGRID_FROM_EMAIL=noreply@walletpass-for-logistics.pl
# Public URL used in e-mail links (defaults to PUBLIC_BASE_URL)
# APP_BASE_URL=https://walletpass-for-logistics.pl
# Comma-separated admin e-mails (auto-promoted to role=admin)
# ADMIN_EMAILS=you@example.com
